{
  "name": "mini-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@tiptap/extension-focus": "^3.31.4",
    "@tiptap/extension-heading": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@vueuse/core": "^15.0.0",
    "daisyui": "^3.9.2",
    "fuse.js": "^7.5.0",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "requestidlecallback-polyfill": "^1.0.2",
    "tailwindcss": "^3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tg": "^0.10.0",
    "vue3-touch-events": "^5.0.15"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node18": "^18.2.7",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "npm-run-all2": "^9.0.3",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.12"
  }
}
